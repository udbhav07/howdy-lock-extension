#!/usr/bin/python3
"""Stop KDE's idle auto-lock while *you* (your Howdy face model) are in front of the IR camera,
and photograph whoever types a wrong password on the lock screen.

  presence-guard        watch: run swayidle so `idle` fires just before KDE's auto-lock, stop Howdy's
                        lock-screen check when the screen unlocks, photograph wrong passwords, and
                        announce new attempts with a notification at unlock
  presence-guard idle   look once; if it's you or the camera is busy, report activity so KDE restarts its lock timer
  presence-guard check  look once, print owner/stranger/nobody/busy, exit 0 only for owner
  presence-guard photo  test the chosen camera: take the photos into the test folder (never an attempt)
  presence-guard ui     open the app (--since=NAME: only attempts newer than NAME, as the unlock notification does)

presence-guard never locks anything itself: if it isn't you, KDE simply locks on schedule.
"""
import configparser
import getpass
import glob
import json
import os
import queue
import shutil
import subprocess
import sys
import threading
import time
import traceback

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from pg import store  # noqa: E402
from pg.system import kde_lock_seconds  # noqa: E402

LOOK_SECONDS = 3     # how long to look per check
LEAD_SECONDS = 15    # check this long before KDE's auto-lock (model loading + LOOK_SECONDS)
DARK_MEAN = 10       # skip near-black frames (IR emitter still warming up)
MAX_HEIGHT = 320     # Howdy's max_height: frames are scaled to this before matching
DLIB_DATA = "/usr/share/howdy/dlib-data/"
PHOTOS = 5           # photos per wrong password
PHOTO_GAP = 12       # frames between photos (~0.4 s at 30 fps)
WARMUP_FRAMES = 30   # let auto-exposure settle; the first frames are dark
UNLOCK_GRACE = 2     # wait this long after an unlock so a just-typed wrong password reaches us first
LOCK_FAILURE = "pam_unix(kde:auth): authentication failure"  # a wrong (or empty) password, not a failed face check
ME = os.path.realpath(__file__)


def camera_in_use():
    """True if another of your apps (meeting, browser, PipeWire...) has any camera open."""
    for fd in glob.glob("/proc/[0-9]*/fd/*"):
        try:
            if os.readlink(fd).startswith("/dev/video") and fd.split("/")[2] != str(os.getpid()):
                return True
        except OSError:
            pass  # process exited, or not ours (e.g. Howdy running as root)
    return False


def look():
    """Return "owner", "stranger" (a face that isn't you), "nobody", or "busy" (a camera is in use)."""
    if camera_in_use():
        return "busy"
    import cv2
    import dlib
    import numpy as np

    howdy = configparser.ConfigParser()
    howdy.read("/etc/howdy/config.ini")
    camera = howdy.get("video", "device_path")  # the IR camera Howdy uses
    certainty = howdy.getfloat("video", "certainty", fallback=3.5) / 10  # same scale Howdy uses
    encodings = np.array([d for m in json.load(open(f"/etc/howdy/models/{getpass.getuser()}.dat")) for d in m["data"]])
    detector = dlib.get_frontal_face_detector()
    predictor = dlib.shape_predictor(DLIB_DATA + "shape_predictor_5_face_landmarks.dat")
    encoder = dlib.face_recognition_model_v1(DLIB_DATA + "dlib_face_recognition_resnet_model_v1.dat")

    cam = cv2.VideoCapture(camera, cv2.CAP_V4L2)
    seen = "busy"  # stays "busy" unless we actually get a frame (camera in use by a meeting app etc.)
    end = time.monotonic() + LOOK_SECONDS
    try:
        while cam.isOpened() and time.monotonic() < end:
            ok, frame = cam.read()
            if not ok:
                continue
            if seen == "busy":
                seen = "nobody"
            if frame.mean() < DARK_MEAN:
                continue
            scale = MAX_HEIGHT / frame.shape[0]
            if scale < 1:
                frame = cv2.resize(frame, None, fx=scale, fy=scale, interpolation=cv2.INTER_AREA)
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY) if frame.ndim == 3 else frame
            for face in detector(gray, 1):
                encoding = np.array(encoder.compute_face_descriptor(frame, predictor(frame, face), 1))
                if np.linalg.norm(encodings - encoding, axis=1).min() < certainty:
                    return "owner"
                seen = "stranger"
    finally:
        cam.release()
    return seen


def screensaver(method):
    return subprocess.run(["gdbus", "call", "--session", "-d", "org.freedesktop.ScreenSaver", "-o", "/ScreenSaver",
                           "-m", f"org.freedesktop.ScreenSaver.{method}"], capture_output=True, text=True).stdout


def report_activity():
    # Same as touching the mouse: KDE restarts its auto-lock (and sleep) timers.
    screensaver("SimulateUserActivity")


def screen_locked():
    return screensaver("GetActive").startswith("(true")


def stop_howdy():
    # Howdy's lock-screen face check runs as you; KDE leaves it (and the camera) running after a password unlock.
    # Root-owned checks (sudo) are untouched.
    subprocess.run(["pkill", "-u", str(os.getuid()), "-f", r"^/usr/bin/python3 /usr/share/howdy/compare\.py "])


def take_photos(camera, folder):
    """Save up to PHOTOS frames as 1.jpg … k.jpg; return (k, error or None)."""
    import cv2
    cam = cv2.VideoCapture(camera, cv2.CAP_V4L2)
    saved = 0
    try:
        if not cam.isOpened():
            return 0, f"{camera} unavailable"
        # Read every frame and keep every PHOTO_GAP-th: sleeping between reads would return stale buffered frames.
        for n in range(WARMUP_FRAMES + PHOTOS * PHOTO_GAP):
            ok, frame = cam.read()
            if ok and n >= WARMUP_FRAMES and (n - WARMUP_FRAMES) % PHOTO_GAP == 0:
                path = os.path.join(folder, f"{saved + 1}.jpg")
                if cv2.imwrite(path, frame):
                    store._own(path)
                    saved += 1
    finally:
        cam.release()
    return saved, None if saved else f"no frames from {camera}"


class Worker:
    """The only code that creates or updates attempts. Events are handled one at a time, in order."""

    def __init__(self, source):
        self.source = source          # "lock" or "sddm"
        self.events = queue.Queue()
        self.burst = None             # {"first", "last", "path"} of the attempt still collecting failures
        self.last_unlock = 0
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        while True:
            kind, t = self.events.get()
            try:
                self.failure(t) if kind == "failure" else self.unlock(t)
            except Exception:
                traceback.print_exc()  # goes to the journal; keep handling later events

    def failure(self, t):
        settings = store.settings()
        if not store.photos_enabled(settings):
            return  # off, or no camera chosen yet
        if store.burst_continues(self.burst, t) and self.bump(t):
            return
        partial = store.new_attempt(t)
        count, error = take_photos(settings["camera"], partial)
        meta = {"failures": 1, "first_failure": t, "last_failure": t, "photos": count, "error": error,
                "source": self.source, "probably_you": store.probably_you(t, self.last_unlock)}
        self.burst = {"first": t, "last": t, "path": store.finish_attempt(partial, meta)}

    def bump(self, t):
        """Add a failure to the open attempt; False if it has been deleted meanwhile."""
        try:
            meta = store.read_meta(self.burst["path"])
            if meta is None:
                return False
            meta.update(failures=meta.get("failures", 1) + 1, last_failure=t)
            store.write_meta(self.burst["path"], meta)
        except OSError:
            return False
        self.burst["last"] = t
        return True

    def unlock(self, u):
        self.burst, self.last_unlock = None, u
        seen = store.last_seen()
        new = [a for a in store.attempts() if store.is_new(a["name"], seen)]
        for a in new:
            last = a["meta"].get("last_failure")
            if last is not None and not a["meta"].get("probably_you") and store.probably_you(last, u):
                a["meta"]["probably_you"] = True
                store.write_meta(a["path"], a["meta"])
        store.prune()
        if new:
            store.mark_seen(new[0]["name"])
            threading.Thread(target=notify, args=(new, seen), daemon=True).start()


def notify(new, since):
    """Notification with the newest photo; clicking it opens the app on just these attempts."""
    newest = new[0]
    icon = newest["photos"][0] if newest["photos"] else "camera-photo"
    title = f"{len(new)} wrong-password attempt{'s' if len(new) > 1 else ''}"
    when = time.strftime("%a %d %b, %H:%M", time.localtime(newest["time"]))
    body = f"While you were away · latest {when}"
    if all(a["meta"].get("probably_you") for a in new):
        body += " · probably you"
    clicked = subprocess.run(["notify-send", "-a", "Presence Guard", "-i", icon, "-A", "default=Open", title, body],
                             capture_output=True, text=True).stdout.strip()
    if clicked == "default":
        # Its own unit, so restarting presence-guard doesn't close the window.
        subprocess.run(["systemd-run", "--user", "--collect", "--quiet",
                        "-E", "WAYLAND_DISPLAY", "-E", "DISPLAY", "-E", "XDG_RUNTIME_DIR",
                        ME, "ui", f"--since={since or ''}"])


def watch_journal(args, needle, worker):
    """Queue a failure for each journal line containing `needle`; exit if the journal goes away."""
    journal = subprocess.Popen(["journalctl", "-f", "-n0", "-o", "short-unix", *args], stdout=subprocess.PIPE, text=True)
    for line in journal.stdout:
        if needle in line:
            try:
                t = float(line.split(" ", 1)[0])
            except ValueError:
                t = time.time()
            worker.events.put(("failure", t))
    os._exit(1)  # journal gone: let systemd restart the whole service


def watch():
    worker = Worker("lock")
    # The lock screen runs as you, so its PAM failures land in your own journal (no root needed).
    threading.Thread(target=watch_journal, daemon=True,
                     args=([f"_UID={os.getuid()}", "_COMM=kscreenlocker_g"], LOCK_FAILURE, worker)).start()
    lock = kde_lock_seconds()
    if lock > LEAD_SECONDS:
        # swayidle only counts down while nothing blocks idle, so meetings/videos never trigger a check.
        subprocess.Popen(["swayidle", "timeout", str(lock - LEAD_SECONDS), f"'{ME}' idle"])
    monitor = subprocess.Popen(["gdbus", "monitor", "--session", "--dest", "org.freedesktop.ScreenSaver"],
                               stdout=subprocess.PIPE, text=True)
    for line in monitor.stdout:
        if "ActiveChanged (false" in line:  # screen just unlocked
            stop_howdy()
            threading.Timer(UNLOCK_GRACE, worker.events.put, (("unlock", time.time()),)).start()
    sys.exit("lost connection to KDE")  # systemd restarts us (and swayidle with us)


def photo():
    camera = store.settings()["camera"]
    if not camera:
        sys.exit("No camera chosen: open Presence Guard → Settings and pick your camera.")
    folder = store.test_dir()
    shutil.rmtree(folder, ignore_errors=True)
    count, error = take_photos(camera, store.private_dir(folder))
    print(f"{count} photo(s) in {folder}" + (f" ({error})" if error else ""))
    sys.exit(0 if count else 1)


if __name__ == "__main__":
    mode = sys.argv[1:]
    if mode == ["check"]:
        result = look()
        print(result)
        sys.exit(0 if result == "owner" else 1)
    if mode == ["photo"]:
        photo()
    if mode[:1] == ["ui"]:
        from pg import ui
        since = next((a.split("=", 1)[1] for a in mode[1:] if a.startswith("--since=")), None)
        sys.exit(ui.main(since))
    if mode == ["idle"]:
        # Idle time keeps counting on the lock screen; there's no auto-lock left to stop, so don't touch the camera.
        if not screen_locked() and look() in ("owner", "busy"):  # busy: camera in use (e.g. a meeting), so you're likely here
            report_activity()
    else:
        watch()
