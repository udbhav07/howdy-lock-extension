[Unit]
Description=presence-guard: no auto-lock while you are at the camera, photos of wrong passwords on the lock screen
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Checks the IR camera just before KDE's auto-lock (timeout read from KDE), and watches the lock screen for wrong passwords.
ExecStart=%h/.local/bin/presence-guard
Restart=on-failure

[Install]
WantedBy=graphical-session.target
