[Unit]
Description=Stop KDE idle auto-lock while you are in front of the IR camera (presence-guard)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Checks the camera just before KDE's auto-lock fires; reads the timeout from KDE's settings.
ExecStart=%h/.local/bin/presence-guard
Restart=on-failure

[Install]
WantedBy=graphical-session.target
